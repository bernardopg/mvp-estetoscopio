# Ambiente de desenvolvimento — copie para .env.local e preencha.
# (.env.local não é versionado)

# Segurança — OBRIGATÓRIO em produção (usado para assinar os JWTs)
JWT_SECRET=troque-por-um-segredo-forte

# URL base do app (usada em links de email, ex.: recuperação de senha)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP para envio de email (recuperação de senha).
# Se não configurado, o app registra o link de recuperação no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido nos emails
SMTP_FROM="MVP Estetoscópio <no-reply@exemplo.com>"
