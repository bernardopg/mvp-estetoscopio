# Ambiente de desenvolvimento do frontend — copie para .env.local e preencha.
# (.env.local não é versionado)

# URL base do app (usada em links de email de recuperação de senha, gerados
# pelo backend PHP em deploy/api/).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# O backend (autenticação, banco, envio de email) roda em PHP dentro de
# deploy/api/ — sem variáveis de ambiente Node. Veja deploy/api/_mailer.php
# (MAIL_FROM) e deploy/api/_lib.php (APP_URL) para configuração do servidor.
